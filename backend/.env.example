# KhaataAI Backend - Environment Variables
# Copy this to .env and fill in the values

# Database: Supabase PostgreSQL Transaction Pooler (port 6543)
# Get from: Supabase Dashboard > Connect > Transaction Pooler > URI
DATABASE_URL=

# Database: Supabase PostgreSQL Session Pooler (port 5432) — used only for migrations
# Get from: Supabase Dashboard > Connect > Session Pooler > URI
DATABASE_URL_MIGRATE=

# Google Gemini API Key
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model name (e.g. gemini-2.0-flash)
# See available models at: https://aistudio.google.com
GEMINI_MODEL=

# JWT signing secret (64-character hex string)
# Auto-generated during setup, or create your own
JWT_SECRET=

# Admin account credentials (created by seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Server port (local dev only)
PORT=5000

# Environment
NODE_ENV=development
