{
  "name": "khaataai-backend",
  "version": "1.0.0",
  "description": "KhaataAI Backend - Intelligent Document Processing API for Indian small businesses",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "migrate": "node database/migrate.js",
    "seed:admin": "node database/seed-admin.js",
    "seed:demo": "node database/seed-demo.js",
    "make:samples": "node scripts/make-samples.js",
    "check-env": "node scripts/check-env.js",
    "test": "node --test tests/**/*.test.js",
    "smoke": "node scripts/smoke-test.js",
    "lint": "eslint src/ --ext .js",
    "format": "prettier --write \"src/**/*.js\" \"database/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\""
  },
  "keywords": [
    "invoice",
    "gst",
    "india",
    "ai",
    "document-processing"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.25.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.9"
  }
}
